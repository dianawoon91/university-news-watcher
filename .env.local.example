# === REQUIRED ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === OPTIONAL: Serper API for Google News search (free tier: 2,500 queries/month) ===
# Get your key at https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# === OPTIONAL: Email digest (uses Gmail App Password or any SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
DEFAULT_RECIPIENT=team@yourcompany.com

# === APP CONFIG ===
NEXT_PUBLIC_APP_NAME=University News Watcher
